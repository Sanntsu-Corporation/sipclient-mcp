# e2e/asterisk/Dockerfile.sipp
#
# Internal test-infrastructure image for the sipclient-mcp §14.5 interop
# gate. This is the sipp SIP test client that drives scenarios against the
# `asterisk` service (see the neighboring Dockerfile) -- not the platform
# under test.
#
# Ubuntu 24.04 "noble" universe ships sip-tester 1:3.7.2-1build3, the exact
# version this rig ran natively on the host before containerization. Do not
# bump this without re-running the full scenario matrix (parity gate).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# sip-tester (Ubuntu's sipp package) lives in universe, like asterisk in the
# neighboring Dockerfile. Its package also ships the pcap audio files under
# /usr/share/sip-tester/ that scenarios/echo-{pcmu,pcma}.xml reference
# via play_pcap_audio -- no separate pcap volume mount is needed.
RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    add-apt-repository universe && \
    apt-get update && \
    apt-get install -y --no-install-recommends sip-tester=1:3.7.2-1build3 && \
    rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["sipp"]
