/bin/

# Stray `go build` output at the repo root. `make build` writes to /bin/ above,
# but a bare `go build ./cmd/sipclient-mcpd` or `go build ./e2e/loop` during a
# verification pass drops a ~15MB ELF here instead; these are reproducible
# build output, never source.
/sipclient-mcpd
/loop

# TLS certs generated by e2e/asterisk/gen-certs.sh -- never commit these.
/e2e/asterisk/keys/
/e2e/asterisk/conf/keys/
graphify-out/
# graphify intermediate files written to the repo root.
.graphify_*

# T7 (P2 W2c): per-call pcap artifacts the loop gate's capture_start/stop
# writes under e2e/loop/policy.yaml's artifact.dir -- never commit these.
/e2e/loop/artifacts/

# Call-transfer interop rig (e2e/asterisk-xfer): generated TLS keys and pcaps.
/e2e/asterisk-xfer/conf/keys/
/e2e/asterisk-xfer/captures/

# Local git worktrees used for isolated feature-branch work.
/.worktrees/

# proxy-dist build output
/dist/

# Passwords
.secret/
.secrets/
